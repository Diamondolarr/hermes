FROM node:20-bookworm AS frontend-build

WORKDIR /repo/frontend

COPY frontend/package*.json ./
RUN npm ci

COPY frontend/ ./
ENV NEXT_TELEMETRY_DISABLED=1
ENV NEXT_PUBLIC_API_BASE_URL=/api
RUN npm run build

FROM node:20-bookworm AS runtime

ENV PYTHONUNBUFFERED=1
ENV NODE_ENV=production
ENV NEXT_TELEMETRY_DISABLED=1
ENV NEXT_PUBLIC_API_BASE_URL=/api
ENV PATH="/opt/venv/bin:${PATH}"

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        ca-certificates \
        gettext-base \
        nginx \
        python3 \
        python3-pip \
        python3-venv \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

COPY requirements.txt ./
RUN python3 -m venv /opt/venv \
    && pip install --no-cache-dir -r requirements.txt

COPY app ./app
COPY --from=frontend-build /repo/frontend/.next/standalone ./frontend
COPY --from=frontend-build /repo/frontend/.next/static ./frontend/.next/static
COPY --from=frontend-build /repo/frontend/public ./frontend/public

COPY deploy/nginx.conf.template /etc/nginx/templates/default.conf.template
COPY deploy/start-vercel.sh /usr/local/bin/start-vercel.sh
RUN chmod +x /usr/local/bin/start-vercel.sh

EXPOSE 80

CMD ["start-vercel.sh"]
